# JSICP Backend Environment Configuration
PORT=4000

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jsicp_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=jsicp_db
AI_SERVICE_URL=http://127.0.0.1:8000

# Google Gemini (server-side only; never put this value in VITE_* frontend variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
